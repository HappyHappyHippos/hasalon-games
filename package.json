{
  "name": "multiplayer-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "הסלון — a small site for playing multiplayer games with friends: Gun Mayhem and Achtung die Kurve.",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @mg/server",
    "dev:client": "npm run dev --workspace @mg/client",
    "build": "npm run build --workspace @mg/client && npm run build --workspace @mg/server",
    "start": "node packages/server/dist/server.js",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-ws.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
